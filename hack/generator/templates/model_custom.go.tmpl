	"context"
	"fmt"

	"github.com/zeromicro/go-zero/core/stores/cache"
	"github.com/zeromicro/go-zero/core/stores/sqlx"
)

var _ {{.EntityName}}Model = (*custom{{.EntityName}}Model)(nil)

type (
	// {{.EntityName}}Model is an interface to be customized, add more methods here,
	// and implement the added methods in custom{{.EntityName}}Model.
	{{.EntityName}}Model interface {
		{{.EntityLower}}Model
		FindPageList(ctx context.Context, page, pageSize int64, keyword string) ([]*{{.EntityName}}, int64, error)
	}

	custom{{.EntityName}}Model struct {
		*default{{.EntityName}}Model
	}
)

// New{{.EntityName}}Model returns a model for the database table.
func New{{.EntityName}}Model(conn sqlx.SqlConn, c cache.CacheConf, opts ...cache.Option) {{.EntityName}}Model {
	return &custom{{.EntityName}}Model{
		default{{.EntityName}}Model: new{{.EntityName}}Model(conn, c, opts...),
	}
}

// FindPageList 分页条件查询
func (m *custom{{.EntityName}}Model) FindPageList(ctx context.Context, page, pageSize int64, keyword string) ([]*{{.EntityName}}, int64, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	offset := (page - 1) * pageSize

	var total int64
	countQuery := fmt.Sprintf("SELECT count(1) FROM %s", m.table)
	var countArgs []any
	if keyword != "" {
		countQuery += " WHERE `{{.SearchColumn}}` LIKE ?"
		countArgs = append(countArgs, "%"+keyword+"%")
	}

	err := m.QueryRowNoCacheCtx(ctx, &total, countQuery, countArgs...)
	if err != nil {
		return nil, 0, err
	}

	var listArgs []any
	listQuery := fmt.Sprintf("SELECT %s FROM %s", {{.EntityLower}}Rows, m.table)
	if keyword != "" {
		listQuery += " WHERE `{{.SearchColumn}}` LIKE ?"
		listArgs = append(listArgs, "%"+keyword+"%")
	}
	listQuery += " ORDER BY id DESC LIMIT ?, ?"
	listArgs = append(listArgs, offset, pageSize)

	var list []*{{.EntityName}}
	err = m.QueryRowsNoCacheCtx(ctx, &list, listQuery, listArgs...)
	if err != nil {
		return nil, 0, err
	}

	return list, total, nil
}
