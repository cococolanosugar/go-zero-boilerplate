syntax = "v1"

type (
	OrderDetailReq {
		OrderId int64 `form:"orderId,default=1001,optional"`
	}
	OrderDetailResp {
		OrderId  int64   `json:"orderId"`
		Item     string  `json:"item"`
		Amount   float64 `json:"amount"`
		Status   string  `json:"status"`
		// 聚合用户微服务信息
		UserId   int64   `json:"userId"`
		UserName string  `json:"userName"`
		Avatar   string  `json:"avatar"`
	}
	DashboardReq {
		OrderId int64 `form:"orderId,optional"`
	}
	DashboardResp {
		UserInfo UserInfoResp    `json:"userInfo"`
		Order    OrderDetailResp `json:"order"`
		SysTime  int64           `json:"sysTime"`
	}
)

@server (
	prefix: /api/v1/order
	group:  order
	jwt:    Auth
)
service gateway {
	@doc "获取订单详情（聚合订单与用户信息）"
	@handler GetOrderDetail
	get /detail (OrderDetailReq) returns (OrderDetailResp)

	@doc "获取大盘聚合信息（mr.Finish 内网并发拉取微服务）"
	@handler GetDashboardOverview
	get /dashboard (DashboardReq) returns (DashboardResp)
}

