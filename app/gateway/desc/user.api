syntax = "v1"

type (
	UserInfoReq {
		Id int64 `form:"id,optional"`
	}
	UserInfoResp {
		Id     int64  `json:"id"`
		Name   string `json:"name"`
		Mobile string `json:"mobile"`
		Avatar string `json:"avatar"`
	}
	RegisterReq {
		Username string `json:"username,optional"`
		Mobile   string `json:"mobile"`
		Password string `json:"password"`
	}
	RegisterResp {
		Id int64 `json:"id"`
	}
	LoginReq {
		Mobile   string `json:"mobile"`
		Password string `json:"password"`
	}
	LoginResp {
		AccessToken  string `json:"accessToken"`
		AccessExpire int64  `json:"accessExpire"`
		RefreshAfter int64  `json:"refreshAfter"`
		UserId       int64  `json:"userId"`
		Username     string `json:"username"`
	}
)

@server (
	prefix: /api/v1/user
	group:  user
)
service gateway {
	@doc "用户注册"
	@handler Register
	post /register (RegisterReq) returns (RegisterResp)

	@doc "用户登录"
	@handler Login
	post /login (LoginReq) returns (LoginResp)
}

@server (
	prefix: /api/v1/user
	group:  user
	jwt:    Auth
)
service gateway {
	@doc "获取当前登录用户信息（受保护路由，强制由 JWT Claims 解析身份，杜绝水平越权）"
	@handler GetUserInfo
	get /info returns (UserInfoResp)
}


// =============================================================
// 岗位信息表 (sys_post)
// =============================================================

type (
	SysPostItem {
		Id int64 `json:"id"` // 岗位ID
		PostCode string `json:"postCode"` // 岗位编码
		PostName string `json:"postName"` // 岗位名称
		PostSort int64 `json:"postSort"` // 显示顺序
		Status int64 `json:"status"` // 状态（1正常 0停用）
		Remark string `json:"remark"` // 备注
		CreateTime string `json:"createTime"` // 创建时间
		UpdateTime string `json:"updateTime"` // 更新时间
	}

	ListSysPostReq {
		Page     int32  `form:"page,default=1"`
		PageSize int32  `form:"pageSize,default=10"`
		Keyword  string `form:"keyword,optional"`
	}

	ListSysPostResp {
		Total int64                `json:"total"`
		List  []*SysPostItem `json:"list"`
	}

	CreateSysPostReq {
		PostCode string `json:"postCode"` // 岗位编码
		PostName string `json:"postName"` // 岗位名称
		PostSort int64 `json:"postSort"` // 显示顺序
		Status int64 `json:"status"` // 状态（1正常 0停用）
		Remark string `json:"remark,optional"` // 备注
	}

	UpdateSysPostReq {
		Id int64 `json:"id"` // 岗位ID
		PostCode string `json:"postCode"` // 岗位编码
		PostName string `json:"postName"` // 岗位名称
		PostSort int64 `json:"postSort"` // 显示顺序
		Status int64 `json:"status"` // 状态（1正常 0停用）
		Remark string `json:"remark"` // 备注
	}
)

@server (
	prefix: /api/v1/user/sys-post
	group:  sys_post
	jwt:    Auth
)
service gateway {
	@doc "获取岗位信息表列表"
	@handler ListSysPost
	get / (ListSysPostReq) returns (ListSysPostResp)

	@doc "获取岗位信息表详情"
	@handler GetSysPost
	get /:id (SysIdReq) returns (SysPostItem)

	@doc "创建岗位信息表"
	@handler CreateSysPost
	post / (CreateSysPostReq) returns (SysIdResp)

	@doc "更新岗位信息表"
	@handler UpdateSysPost
	put / (UpdateSysPostReq) returns (SysEmptyResp)

	@doc "删除岗位信息表"
	@handler DeleteSysPost
	delete /:id (SysIdReq) returns (SysEmptyResp)
}


// =============================================================
// 通知公告表 (sys_notice)
// =============================================================

type (
	SysNoticeItem {
		Id int64 `json:"id"` // 公告ID
		NoticeTitle string `json:"noticeTitle"` // 公告标题
		NoticeType int64 `json:"noticeType"` // 公告类型（1通知 2消息 3待办）
		NoticeContent string `json:"noticeContent"` // 公告内容
		Status int64 `json:"status"` // 公告状态（1正常 0关闭）
		CreateBy string `json:"createBy"` // 创建者
		Remark string `json:"remark"` // 备注
		CreateTime string `json:"createTime"` // 创建时间
		UpdateTime string `json:"updateTime"` // 更新时间
	}

	ListSysNoticeReq {
		Page     int32  `form:"page,default=1"`
		PageSize int32  `form:"pageSize,default=10"`
		Keyword  string `form:"keyword,optional"`
	}

	ListSysNoticeResp {
		Total int64                `json:"total"`
		List  []*SysNoticeItem `json:"list"`
	}

	CreateSysNoticeReq {
		NoticeTitle string `json:"noticeTitle"` // 公告标题
		NoticeType int64 `json:"noticeType"` // 公告类型（1通知 2消息 3待办）
		NoticeContent string `json:"noticeContent"` // 公告内容
		Status int64 `json:"status"` // 公告状态（1正常 0关闭）
		CreateBy string `json:"createBy"` // 创建者
		Remark string `json:"remark,optional"` // 备注
	}

	UpdateSysNoticeReq {
		Id int64 `json:"id"` // 公告ID
		NoticeTitle string `json:"noticeTitle"` // 公告标题
		NoticeType int64 `json:"noticeType"` // 公告类型（1通知 2消息 3待办）
		NoticeContent string `json:"noticeContent"` // 公告内容
		Status int64 `json:"status"` // 公告状态（1正常 0关闭）
		CreateBy string `json:"createBy"` // 创建者
		Remark string `json:"remark"` // 备注
	}

	NoticeFeedItem {
		Id int64 `json:"id"`
		NoticeTitle string `json:"noticeTitle"`
		NoticeType int64 `json:"noticeType"`
		NoticeContent string `json:"noticeContent"`
		Status int64 `json:"status"`
		CreateBy string `json:"createBy"`
		Remark string `json:"remark"`
		CreateTime string `json:"createTime"`
		UpdateTime string `json:"updateTime"`
		IsRead bool `json:"isRead"`
	}

	GetMyNoticeFeedReq {
		Limit int64 `form:"limit,optional,default=50"`
	}

	GetMyNoticeFeedResp {
		TotalUnread int64 `json:"totalUnread"`
		List []*NoticeFeedItem `json:"list"`
	}

	MarkNoticeReadReq {
		NoticeId int64 `json:"noticeId"`
	}

	MarkAllNoticesReadReq {
		NoticeType int64 `json:"noticeType,optional"`
	}
)

@server (
	prefix: /api/v1/user/sys-notice
	group:  sys_notice
	jwt:    Auth
)
service gateway {
	@doc "获取通知公告表列表"
	@handler ListSysNotice
	get / (ListSysNoticeReq) returns (ListSysNoticeResp)

	@doc "获取通知公告表详情"
	@handler GetSysNotice
	get /:id (SysIdReq) returns (SysNoticeItem)

	@doc "创建通知公告表"
	@handler CreateSysNotice
	post / (CreateSysNoticeReq) returns (SysIdResp)

	@doc "更新通知公告表"
	@handler UpdateSysNotice
	put / (UpdateSysNoticeReq) returns (SysEmptyResp)

	@doc "删除通知公告表"
	@handler DeleteSysNotice
	delete /:id (SysIdReq) returns (SysEmptyResp)
}

@server (
	prefix: /api/v1/user/notice
	group:  user_notice
	jwt:    Auth
)
service gateway {
	@doc "获取当前员工个人通知流与未读数"
	@handler GetMyNoticeFeed
	get /my-list (GetMyNoticeFeedReq) returns (GetMyNoticeFeedResp)

	@doc "标记单条通知已读"
	@handler MarkNoticeRead
	post /read (MarkNoticeReadReq) returns (SysEmptyResp)

	@doc "全部标记已读"
	@handler MarkAllNoticesRead
	post /read-all (MarkAllNoticesReadReq) returns (SysEmptyResp)
}

// =============================================================
// 组织机构部门管理 (sys_dept)
// =============================================================

type (
	SysDeptItem {
		Id int64 `json:"id"`
		ParentId int64 `json:"parentId"`
		Ancestors string `json:"ancestors"`
		DeptName string `json:"deptName"`
		Sort int64 `json:"sort"`
		Leader string `json:"leader"`
		Phone string `json:"phone"`
		Status int64 `json:"status"`
		CreateTime string `json:"createTime"`
		UpdateTime string `json:"updateTime"`
		Children []*SysDeptItem `json:"children,omitempty"`
	}

	ListSysDeptReq {
		Keyword string `form:"keyword,optional"`
		Status int64 `form:"status,optional,default=-1"`
	}

	ListSysDeptResp {
		List []*SysDeptItem `json:"list"`
	}

	CreateSysDeptReq {
		ParentId int64 `json:"parentId"`
		DeptName string `json:"deptName"`
		Sort int64 `json:"sort,optional"`
		Leader string `json:"leader,optional"`
		Phone string `json:"phone,optional"`
		Status int64 `json:"status,optional,default=1"`
	}

	UpdateSysDeptReq {
		Id int64 `json:"id"`
		ParentId int64 `json:"parentId"`
		DeptName string `json:"deptName"`
		Sort int64 `json:"sort"`
		Leader string `json:"leader,optional"`
		Phone string `json:"phone,optional"`
		Status int64 `json:"status"`
	}
)

@server (
	prefix: /api/v1/user/dept
	group:  sys_dept
	jwt:    Auth
)
service gateway {
	@doc "获取部门树形列表"
	@handler ListSysDept
	get / (ListSysDeptReq) returns (ListSysDeptResp)

	@doc "获取部门详情"
	@handler GetSysDept
	get /:id (SysIdReq) returns (SysDeptItem)

	@doc "创建新部门"
	@handler CreateSysDept
	post / (CreateSysDeptReq) returns (SysIdResp)

	@doc "更新部门"
	@handler UpdateSysDept
	put / (UpdateSysDeptReq) returns (SysEmptyResp)

	@doc "删除部门"
	@handler DeleteSysDept
	delete /:id (SysIdReq) returns (SysEmptyResp)
}


