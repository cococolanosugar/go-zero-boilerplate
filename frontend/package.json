{
  "name": "go-zero-boilerplate-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:admin": "pnpm --filter @zero/admin dev",
    "dev:admin:test": "pnpm --filter @zero/admin dev:test",
    "dev:admin:pre": "pnpm --filter @zero/admin dev:pre",
    "dev:portal": "pnpm --filter @zero/portal dev",
    "dev:portal:test": "pnpm --filter @zero/portal dev:test",
    "dev:portal:pre": "pnpm --filter @zero/portal dev:pre",
    "build": "pnpm -r build",
    "gen:api": "goctl api ts --api ../app/gateway/desc/gateway.api --dir ./packages/api/src"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
