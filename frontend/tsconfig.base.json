{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@zero/api": ["packages/api/src"],
      "@zero/api/*": ["packages/api/src/*"],
      "@zero/shared": ["packages/shared/src"],
      "@zero/shared/*": ["packages/shared/src/*"]
    }
  }
}
